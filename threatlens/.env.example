# Banco primário (users/tokens) — usado pelo container "db" e pela app
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=uma-chave-bem-grande-e-secreta

# Banco externo "asgard" (posts, somente leitura)
POSTS_DB_URL=jdbc:postgresql://host:5432/asgard
POSTS_DB_USERNAME=asgard_reader
POSTS_DB_PASSWORD=

# SMTP
MAIL_PASSWORD=

# Admin inicial (opcional)
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
