# Copie para .env (na raiz do repositório) e preencha antes de rodar `docker compose up -d --build`

# Porta HTTP em que o front-end fica exposto no servidor
HTTP_PORT=80

# Banco primário (users/tokens) — criado pelo container "db" e usado pela API
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha

# JWT (obrigatório) — use uma chave longa e aleatória, ex.: `openssl rand -base64 64`
JWT_SECRET=

# Banco externo "asgard" (posts, somente leitura) — obrigatório
# Se o banco roda na própria máquina do servidor, use host.docker.internal no lugar de localhost
POSTS_DB_URL=jdbc:postgresql://host.docker.internal:5432/asgard
POSTS_DB_USERNAME=asgard_reader
POSTS_DB_PASSWORD=

# SMTP (Gmail) — envio dos códigos OTP
MAIL_USERNAME=threatlens2025@gmail.com
MAIL_PASSWORD=

# Admin inicial (opcional) — criado no primeiro boot se ainda não existir nenhum ADMIN
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Cookies de sessão com atributo Secure. Use true quando o servidor estiver atrás de HTTPS;
# com true em HTTP puro, o navegador descarta os cookies e o login não funciona.
COOKIE_SECURE=false
